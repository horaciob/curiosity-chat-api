SERVER_PORT=8081

DB_HOST=localhost
DB_PORT=5434
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=curiosity_chat
DB_SSL_MODE=disable

# user-api public keys for EdDSA tokens.
JWT_JWKS_URL=http://localhost:8084/.well-known/jwks.json
# Legacy HS256 secret: only while migrating; leave empty once user-api signs EdDSA.
JWT_SECRET=your-secret-here

USER_API_URL=http://localhost:8084

LOG_LEVEL=info
LOG_FORMAT=console
